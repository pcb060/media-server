# Immich + Postgres credentials
# Pick a strong random DB password (e.g. `openssl rand -base64 24`).
# IMMICH_* and POSTGRES_* must use the same DB password.
IMMICH_DB_USERNAME=postgres
IMMICH_DB_DATABASE_NAME=immich
IMMICH_DB_PASSWORD=<change-me>

POSTGRES_USER=postgres
POSTGRES_DB=immich
POSTGRES_PASSWORD=<change-me>
