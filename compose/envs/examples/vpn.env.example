# ProtonVPN WireGuard configuration
# Generate credentials at https://account.proton.me/u/0/vpn/WireGuard
# NAT-PMP port forwarding requires a paid Proton plan; leave VPN_PORT_FORWARDING=off
# on the free tier.
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard

# Per-key pair: PRIVATE key goes here, PUBLIC key is your WireGuard public key
WIREGUARD_PRIVATE_KEY=<proton-wireguard-private-key>
WIREGUARD_PUBLIC_KEY=<proton-wireguard-public-key>

# IPv4-only tunnel (no IPv6 leak); Proton assigns the /32
WIREGUARD_ADDRESSES=10.2.0.2/32

# WireGuard endpoint (server IP:port); pick from Proton's WireGuard config export
WIREGUARD_ENDPOINT=<proton-server-ip:51820>

# Use Proton's internal DNS (gluetun rewrites /etc/resolv.conf)
WIREGUARD_DNS=10.2.0.1

# userspace = wireguard-go inside container, no kernel module required
VPN_WIREGUARD_IMPLEMENTATION=userspace

# NAT-PMP port forwarding (paid plan only)
VPN_PORT_FORWARDING=on

# Drop traffic that tries to bypass the tunnel
FIREWALL=on
