# Homepage widget credentials
# All API keys here mirror what each backing service uses; keep in sync.
# Replace every <change-me> placeholder before starting the homepage container.

# Bazarr
HOMEPAGE_VAR_BAZARR_API_KEY=<change-me>

# Calibre-Web-Automated
HOMEPAGE_VAR_CWA_USR=<change-me>
HOMEPAGE_VAR_CWA_PWD=<change-me>

# Host mount point shown on dashboard
HOMEPAGE_VAR_HDD_MNT_POINT=/home/<user>/media-server/media

# Immich
HOMEPAGE_VAR_IMMICH_API_KEY=<change-me>

# Jellyfin
HOMEPAGE_VAR_JELLYFIN_API_KEY=<change-me>

# NetAlertX
HOMEPAGE_VAR_NETALERTX_API_KEY=<change-me>

# Nginx Proxy Manager admin (NPM exposes its own UI; homepage widget reads it)
HOMEPAGE_VAR_NPM_USR=<change-me>
HOMEPAGE_VAR_NPM_PWD=<change-me>

# Prowlarr
HOMEPAGE_VAR_PROWLARR_API_KEY=<change-me>

# qBittorrent
HOMEPAGE_VAR_QBITTORRENT_USR=<change-me>
HOMEPAGE_VAR_QBITTORRENT_PWD=<change-me>

# Radarr
HOMEPAGE_VAR_RADARR_API_KEY=<change-me>

# Jellyseerr / Seerr
HOMEPAGE_VAR_SEERR_API_KEY=<change-me>

# Sonarr (TV series)
HOMEPAGE_VAR_SONARR_SERIES_API_KEY=<change-me>

# Sonarr (anime)
HOMEPAGE_VAR_SONARR_ANIME_API_KEY=<change-me>

# Tailscale admin API key (used to show device list on the dashboard)
HOMEPAGE_VAR_TAILSCALE_API_KEY=<change-me>
